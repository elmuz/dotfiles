# ---- GnuPG homedir: only the plaintext-safe config files are tracked ----
# Secret key material, keyring and sshcontrol live exclusively in the
# encrypted archive (yadm encrypt). Never track private-keys-v1.d here.
.local/share/gnupg/*
!.local/share/gnupg/gpg.conf
!.local/share/gnupg/gpg-agent.conf

# ---- Pi agent dir: only portable, non-secret config ----
.pi/agent/sessions/
.pi/agent/bin/
.pi/agent/auth.json
.pi/agent/models-store.json
.pi/agent/trust.json
.pi/agent/mcp-auth.json
